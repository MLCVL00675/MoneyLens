generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  REDEEMED
}

enum AssetType {
  MUTUAL_FUND
  STOCK
  ETF
  CRYPTO
  GOLD
}

// ─── Models ──────────────────────────────────────────────

// ─── Net Worth Tracker Enums ─────────────────────────────

enum FixedDepositType {
  FD
  RD
}

enum CompoundingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
}

enum BondType {
  CORPORATE
  GOVERNMENT
  MUNICIPAL
}

enum CouponFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
  ZERO_COUPON
}

enum GoldType {
  PHYSICAL
  DIGITAL
  SOVEREIGN_GOLD_BOND
  ETF
}

enum PropertyType {
  PLOT
  SELF_OCCUPIED
  RENTAL
  COMMERCIAL
}

enum RetirementAccountType {
  EPF
  PPF
  NPS
  VPF
}

enum LiabilityType {
  HOME_LOAN
  AUTO_LOAN
  PERSONAL_LOAN
  CREDIT_CARD
  EDUCATION_LOAN
  OTHER
}

// ─── Models ──────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts          Account[]
  transactions      Transaction[]
  budget            Budget?
  goals             Goal[]
  categories        Category[]
  investments       Investment[]
  // Net Worth Tracker relations
  fixedDeposits     FixedDeposit[]
  bonds             Bond[]
  sips              SIP[]
  reits             REIT[]
  goldHoldings      GoldHolding[]
  retirementAccounts RetirementAccount[]
  liabilities       Liability[]
  realEstates       RealEstate[]

  @@index([clerkUserId])
}

model Account {
  id               String      @id @default(uuid())
  name             String
  type             AccountType
  balance          Decimal     @default(0) @db.Decimal(12, 2)
  isDefault        Boolean     @default(false)
  isDecommissioned Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions      Transaction[]
  goalContributions GoalContribution[]
  investments       Investment[]

  @@index([userId])
  @@index([isDecommissioned])
}

model Transaction {
  id          String            @id @default(uuid())
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  description String
  date        DateTime
  category    String
  receiptUrl  String?
  status      TransactionStatus @default(COMPLETED)

  // Recurring fields
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?

  // Transfer linking
  transferId        String?
  transferAccountId String?

  // Net Worth Mappings (Loan & SIP)
  expenseType       String?            @default("GENERAL") // "GENERAL" | "INVESTMENT" | "LOAN"
  sipId             String?
  sip               SIP?               @relation(fields: [sipId], references: [id], onDelete: SetNull)
  liabilityId       String?
  liability         Liability?         @relation(fields: [liabilityId], references: [id], onDelete: SetNull)
  allottedUnits     Decimal?           @db.Decimal(18, 4)
  allotmentNav      Decimal?           @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Optional goal reference
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([goalId])
  @@index([sipId])
  @@index([liabilityId])
  @@index([date])
  @@index([type])
  @@index([isRecurring, nextRecurringDate])
}

model Budget {
  id            String    @id @default(uuid())
  amount        Decimal   @db.Decimal(12, 2)
  lastAlertSent DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id            String     @id @default(uuid())
  name          String
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  deadline      DateTime?
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributions GoalContribution[]
  transactions  Transaction[]

  @@index([userId])
  @@index([status])
}

model GoalContribution {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  goalId    String
  goal      Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([accountId])
}

model Category {
  id        String          @id @default(uuid())
  name      String
  icon      String?
  type      TransactionType @default(EXPENSE)
  isDefault Boolean         @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, type, userId])
  @@index([userId])
}

model Investment {
  id              String    @id @default(uuid())
  symbol          String    // e.g. AMFI Scheme Code "122639" or Stock Ticker "RELIANCE.NS"
  name            String    // Scheme name or Company name
  assetType       AssetType @default(MUTUAL_FUND)
  units           Decimal   @db.Decimal(18, 4) // Units held / Quantity
  buyPrice        Decimal   @db.Decimal(12, 2) // Average purchase price / NAV
  currentPrice    Decimal   @default(0) @db.Decimal(12, 2) // Live CMP / Latest NAV
  previousClose   Decimal?  @db.Decimal(12, 2) // Previous day closing price for 1D P&L
  currency        String    @default("INR")
  exchange        String?   // "AMFI", "NSE", "BSE", "NASDAQ"
  category        String?   // e.g. "Equity - Flexi Cap", "Large Cap", "Technology"
  folioOrAccount  String?   // Folio Number or Demat Account
  notes           String?
  lastPriceUpdate DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assetType])
  @@index([symbol])
}

// ─── Net Worth Tracker Models ────────────────────────────

model FixedDeposit {
  id                 String               @id @default(uuid())
  fdType             FixedDepositType     @default(FD)
  bankName           String
  principalAmount    Decimal              @db.Decimal(14, 2)
  interestRate       Decimal              @db.Decimal(6, 4)
  compoundingFreq    CompoundingFrequency @default(QUARTERLY)
  tenureMonths       Int
  startDate          DateTime
  maturityDate       DateTime
  maturityValue      Decimal              @db.Decimal(14, 2)
  currentValue       Decimal              @db.Decimal(14, 2)
  monthlyInstallment Decimal?             @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bond {
  id              String          @id @default(uuid())
  name            String
  bondType        BondType        @default(GOVERNMENT)
  isin            String?
  faceValue       Decimal         @db.Decimal(12, 2)
  couponRate      Decimal         @db.Decimal(6, 4)
  couponFrequency CouponFrequency @default(ANNUALLY)
  purchasePrice   Decimal         @db.Decimal(12, 2)
  quantity        Int             @default(1)
  maturityYear    Int
  currentPrice    Decimal?        @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SIP {
  id             String    @id @default(uuid())
  schemeName     String
  schemeCode     String?
  monthlyAmount  Decimal   @db.Decimal(12, 2)
  startDate      DateTime
  currentNAV     Decimal?  @db.Decimal(12, 4)
  totalUnitsHeld Decimal?  @db.Decimal(18, 4)
  totalInvested  Decimal   @db.Decimal(14, 2)
  currentValue   Decimal?  @db.Decimal(14, 2)
  stepUpRate     Decimal?  @db.Decimal(5, 2)
  expectedReturn Decimal?  @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

model REIT {
  id                String    @id @default(uuid())
  name              String
  symbol            String?
  exchange          String?
  units             Decimal   @db.Decimal(14, 4)
  purchasePrice     Decimal   @db.Decimal(12, 2)
  currentPrice      Decimal   @db.Decimal(12, 2)
  distributionYield Decimal?  @db.Decimal(5, 2)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoldHolding {
  id              String    @id @default(uuid())
  goldType        GoldType  @default(PHYSICAL)
  weightGrams     Decimal?  @db.Decimal(10, 3)
  units           Decimal?  @db.Decimal(14, 4)
  purchasePrice   Decimal   @db.Decimal(12, 2)
  currentSpotRate Decimal   @db.Decimal(12, 2)
  purity          String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RetirementAccount {
  id                   String                @id @default(uuid())
  accountType          RetirementAccountType @default(EPF)
  employeeContribution Decimal               @db.Decimal(12, 2)
  employerContribution Decimal?              @db.Decimal(12, 2)
  interestRate         Decimal               @db.Decimal(6, 4)
  currentCorpus        Decimal               @db.Decimal(14, 2)
  startDate            DateTime?
  accountNumber        String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions RetirementContribution[]

  @@index([userId])
}

model RetirementContribution {
  id                  String            @id @default(uuid())
  retirementAccountId String
  retirementAccount   RetirementAccount @relation(fields: [retirementAccountId], references: [id], onDelete: Cascade)
  date                DateTime          @default(now())
  monthYear           String            // e.g. "Sep 2026"
  employeeShare       Decimal           @db.Decimal(12, 2)
  employerShare       Decimal           @db.Decimal(12, 2) @default(0)
  totalAmount         Decimal           @db.Decimal(12, 2)
  source              String?           @default("MANUAL") // "MANUAL" | "SALARY_DEDUCTION"
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([retirementAccountId])
}

model Liability {
  id                    String        @id @default(uuid())
  liabilityType         LiabilityType @default(PERSONAL_LOAN)
  lenderName            String
  principalRemaining    Decimal       @db.Decimal(14, 2)
  originalPrincipal     Decimal?      @db.Decimal(14, 2)
  interestRate          Decimal       @db.Decimal(6, 4)
  monthlyEMI            Decimal       @db.Decimal(12, 2)
  remainingTenureMonths Int?
  startDate             DateTime?
  endDate               DateTime?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

model RealEstate {
  id               String       @id @default(uuid())
  name             String
  propertyType     PropertyType @default(SELF_OCCUPIED)
  location         String?
  areaSqFt         Decimal?     @db.Decimal(12, 2)
  purchasePrice    Decimal      @db.Decimal(14, 2)
  purchaseDate     DateTime
  appreciationRate Decimal      @default(5.0) @db.Decimal(5, 2)
  currentValuation Decimal      @db.Decimal(14, 2)
  isRental         Boolean      @default(false)
  monthlyRent      Decimal?     @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
